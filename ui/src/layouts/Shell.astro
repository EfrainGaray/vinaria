---
// App shell: icon-only sidebar + radial-gradient main area.
// Active module sets a data attribute on <body> so CSS variables can color
// the background, FAB, sidebar highlight, and feature icons in unison.
import "../styles/global.css";

interface Props {
  title?: string;
  module?: "bottles" | "recipes" | "wine" | "settings" | "logs";
  topbarLabel?: string;
}
const { title = "Vinaria", module = "bottles", topbarLabel = "Bottles" } = Astro.props;

const nav: { mod: NonNullable<Props["module"]>; label: string; glyph: string; href: string }[] = [
  { mod: "bottles",  label: "Bottles",  glyph: "🍷", href: "/" },
  { mod: "recipes",  label: "Recipes",  glyph: "📜", href: "/recipes" },
  { mod: "wine",     label: "Wine",     glyph: "🪵", href: "/wine" },
  { mod: "logs",     label: "Logs",     glyph: "≡",  href: "/logs" },
  { mod: "settings", label: "Settings", glyph: "⚙",  href: "/settings" },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body data-module={module}>
    <div class="app-shell">
      <aside class="sidebar">
        <div class="brand-mark" title="Vinaria">🍷</div>
        {nav.map((n) => (
          <a
            class={`nav-icon ${n.mod === module ? "active" : ""}`}
            href={n.href}
            title={n.label}
            aria-label={n.label}
          >
            <span>{n.glyph}</span>
          </a>
        ))}
      </aside>
      <main class="main">
        <header class="topbar">
          <div class="topbar-title">{topbarLabel}</div>
          <a
            class="cta-amber"
            href="https://github.com/EfrainGaray/vinaria"
            target="_blank"
            rel="noopener"
          >
            ★ Star on GitHub
          </a>
        </header>
        <slot />
      </main>
    </div>
  </body>
</html>
