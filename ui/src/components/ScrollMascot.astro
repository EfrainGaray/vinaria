---
// Recipes module mascot — an unfurled scroll of paper.
---

<svg viewBox="0 0 240 320" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <defs>
    <linearGradient id="scrollPaper" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="rgba(255,255,255,0.85)" />
      <stop offset="100%" stop-color="rgba(255,255,255,0.55)" />
    </linearGradient>
    <linearGradient id="scrollRoll" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="rgba(194,160,78,0.95)" />
      <stop offset="100%" stop-color="rgba(120,90,30,0.95)" />
    </linearGradient>
  </defs>

  <!-- top roll -->
  <rect x="48" y="48" width="144" height="22" rx="11" fill="url(#scrollRoll)" />
  <ellipse cx="48" cy="59" rx="6" ry="11" fill="rgba(90,65,20,0.95)" />
  <ellipse cx="192" cy="59" rx="6" ry="11" fill="rgba(90,65,20,0.95)" />

  <!-- paper body -->
  <path
    d="M 56 68 L 184 68 L 184 248 L 56 248 Z"
    fill="url(#scrollPaper)"
    stroke="rgba(180,140,60,0.4)"
    stroke-width="1"
  />

  <!-- text lines on the scroll -->
  <g fill="rgba(80,55,15,0.45)">
    <rect x="72" y="90"  width="96" height="3" rx="1.5" />
    <rect x="72" y="106" width="80" height="3" rx="1.5" />
    <rect x="72" y="122" width="88" height="3" rx="1.5" />
    <rect x="72" y="148" width="60" height="3" rx="1.5" />
    <rect x="72" y="164" width="96" height="3" rx="1.5" />
    <rect x="72" y="180" width="72" height="3" rx="1.5" />
    <rect x="72" y="206" width="84" height="3" rx="1.5" />
  </g>

  <!-- wax seal -->
  <circle cx="160" cy="230" r="14" fill="rgba(180,60,50,0.9)" />
  <text
    x="160" y="234"
    text-anchor="middle"
    font-family="-apple-system, sans-serif"
    font-size="11"
    font-weight="700"
    fill="rgba(255,255,255,0.85)"
  >V</text>

  <!-- bottom roll -->
  <rect x="48" y="246" width="144" height="22" rx="11" fill="url(#scrollRoll)" />
  <ellipse cx="48" cy="257" rx="6" ry="11" fill="rgba(90,65,20,0.95)" />
  <ellipse cx="192" cy="257" rx="6" ry="11" fill="rgba(90,65,20,0.95)" />
</svg>
