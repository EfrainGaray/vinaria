---
// Settings module mascot — a stylized gear.
---

<svg viewBox="0 0 240 320" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <defs>
    <linearGradient id="gearBody" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="rgba(220,220,225,0.9)" />
      <stop offset="100%" stop-color="rgba(120,120,130,0.9)" />
    </linearGradient>
    <radialGradient id="gearShine" cx="0.35" cy="0.3" r="0.5">
      <stop offset="0%" stop-color="rgba(255,255,255,0.4)" />
      <stop offset="100%" stop-color="rgba(255,255,255,0)" />
    </radialGradient>
  </defs>

  <!-- gear with 12 teeth -->
  <g transform="translate(120 160)">
    <path
      d="
        M -16 -106 L 16 -106 L 22 -92 L 50 -98 L 60 -72 L 86 -60 L 80 -34 L 100 -16
        L 100 16 L 80 34 L 86 60 L 60 72 L 50 98 L 22 92 L 16 106 L -16 106
        L -22 92 L -50 98 L -60 72 L -86 60 L -80 34 L -100 16 L -100 -16
        L -80 -34 L -86 -60 L -60 -72 L -50 -98 L -22 -92 Z
      "
      fill="url(#gearBody)"
      stroke="rgba(90,90,100,0.7)"
      stroke-width="1.5"
    />
    <!-- inner ring -->
    <circle cx="0" cy="0" r="60" fill="rgba(60,60,70,0.85)" />
    <!-- hub hole -->
    <circle cx="0" cy="0" r="22" fill="rgba(30,30,38,0.95)" />
    <circle cx="0" cy="0" r="22" fill="none" stroke="rgba(180,180,190,0.4)" stroke-width="1.5" />
    <!-- shine highlight -->
    <path
      d="M -100 0 A 100 100 0 0 1 0 -100"
      fill="none"
      stroke="rgba(255,255,255,0.25)"
      stroke-width="2"
    />
  </g>
</svg>
