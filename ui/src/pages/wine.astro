---
import Shell from "../layouts/Shell.astro";
import BarrelMascot from "../components/BarrelMascot.astro";

// Phase-xp: the Wine install summary is static. Once Tauri IPC lands, it
// will report the actual ~/.vinaria/wine/ state.
const wineState: {
  installed: boolean;
  version?: string;
  dllCount?: number;
  buildHost?: string;
} = {
  installed: true,
  version: "wine-11.0",
  dllCount: 1017,
  buildHost: "CodeWeavers 26.1.0 source",
};
---

<Shell title="Vinaria — Wine" module="wine" topbarLabel="Wine">
  <section class="hero">
    <div class="hero-art"><BarrelMascot /></div>
    <div>
      <h1 class="hero-title">Wine install</h1>
      <p class="hero-subtitle">
        The runtime that translates Windows calls into macOS calls. Vinaria
        builds it from CodeWeavers' published LGPL source.
      </p>
      {wineState.installed ? (
        <ul class="feature-list">
          <li><span class="feature-icon">●</span>{wineState.version}</li>
          <li><span class="feature-icon">●</span>{wineState.dllCount} built-in DLLs</li>
          <li><span class="feature-icon">●</span>Source: {wineState.buildHost}</li>
        </ul>
      ) : (
        <ul class="feature-list">
          <li><span class="feature-icon">◆</span>Built from CodeWeavers LGPL source</li>
          <li><span class="feature-icon">◆</span>Patched for macOS Sonoma OpenGL</li>
          <li><span class="feature-icon">◆</span>~45 min on Intel — coffee-break length</li>
        </ul>
      )}
    </div>
  </section>
  <button class="fab">{wineState.installed ? "Reinstall" : "Build"}</button>
</Shell>
