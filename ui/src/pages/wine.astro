---
import Shell from "../layouts/Shell.astro";
import BarrelMascot from "../components/BarrelMascot.astro";
---

<Shell title="Vinaria — Wine" module="wine" topbarLabel="Wine">
  <section class="hero">
    <div class="hero-art"><BarrelMascot /></div>
    <div>
      <h1 class="hero-title">Wine install</h1>
      <p class="hero-subtitle">
        The runtime that translates Windows calls into macOS calls. Vinaria
        builds it from CodeWeavers' published LGPL source.
      </p>
      <ul class="feature-list" id="wine-features">
        <li><span class="feature-icon">…</span>Loading state…</li>
      </ul>
    </div>
  </section>
  <button class="fab" id="wine-fab">Reinstall</button>
</Shell>

<script>
  import { wineState } from "../lib/ipc";

  async function render() {
    const state = await wineState();
    const list = document.getElementById("wine-features")!;
    const fab = document.getElementById("wine-fab")!;

    if (!state.installed) {
      list.innerHTML = `
        <li><span class="feature-icon">◆</span>Built from CodeWeavers LGPL source</li>
        <li><span class="feature-icon">◆</span>Patched for macOS Sonoma OpenGL</li>
        <li><span class="feature-icon">◆</span>~45 min on Intel — coffee-break length</li>
      `;
      fab.textContent = "Build";
      return;
    }

    const rows: string[] = [];
    if (state.version) rows.push(`<li><span class="feature-icon">●</span>${escapeHtml(state.version)}</li>`);
    if (state.dll_count) rows.push(`<li><span class="feature-icon">●</span>${state.dll_count} built-in DLLs</li>`);
    rows.push(`<li><span class="feature-icon">●</span>${escapeHtml(state.install_dir)}</li>`);
    list.innerHTML = rows.join("");
    fab.textContent = "Reinstall";
  }

  function escapeHtml(s: string): string {
    return s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]!));
  }

  render().catch((e) => console.error("[wine] load failed:", e));
</script>
