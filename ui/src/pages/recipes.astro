---
import Shell from "../layouts/Shell.astro";
import ScrollMascot from "../components/ScrollMascot.astro";
---

<Shell title="Vinaria — Recipes" module="recipes" topbarLabel="Recipes">
  <div id="recipes-root">
    <section class="hero" id="recipes-hero">
      <div class="hero-art"><ScrollMascot /></div>
      <div>
        <h1 class="hero-title" id="recipes-title">Recipes</h1>
        <p class="hero-subtitle" id="recipes-subtitle">
          A recipe is a TOML file that knows how to set up a bottle for one
          specific Windows app — registry tweaks, DLL overrides, launch env.
        </p>
        <ul class="feature-list">
          <li><span class="feature-icon">◆</span>Community-contributed catalog</li>
          <li><span class="feature-icon">◆</span>Plain-text, diffable, reviewable</li>
          <li><span class="feature-icon">◆</span>Override locally in ~/.vinaria/recipes/</li>
        </ul>
      </div>
    </section>
    <div class="card-grid" id="recipes-grid" style="display: none;"></div>
  </div>
  <button class="fab" id="recipes-fab">Add recipe</button>
</Shell>

<script>
  import { listRecipes } from "../lib/ipc";

  async function render() {
    const recipes = await listRecipes();
    const hero = document.getElementById("recipes-hero")!;
    const grid = document.getElementById("recipes-grid")!;
    const subtitle = document.getElementById("recipes-subtitle")!;

    if (recipes.length === 0) return;

    subtitle.textContent = `${recipes.length} recipe${recipes.length === 1 ? "" : "s"} ready to install.`;
    hero.removeAttribute("style");
    grid.style.display = "";
    grid.innerHTML = "";
    for (const r of recipes) {
      const card = document.createElement("article");
      card.className = "card";
      const meta = [`id · ${r.id}`];
      if (r.steam_app_id) meta.push(`steam ${r.steam_app_id}`);
      card.innerHTML = `
        <h3>${escapeHtml(r.name)}</h3>
        <p class="meta">${meta.join(" · ")}</p>
        <span class="badge ready">ready</span>
      `;
      grid.appendChild(card);
    }
  }

  function escapeHtml(s: string): string {
    return s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]!));
  }

  render().catch((e) => console.error("[recipes] load failed:", e));
</script>
