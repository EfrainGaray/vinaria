---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Vinaria</title>
    <style is:global>
      :root {
        color-scheme: dark;
        --bg: #1a1110;
        --fg: #f3e9d2;
        --accent: #8b3a3a;
      }
      html, body { margin: 0; padding: 0; background: var(--bg); color: var(--fg); font: 14px/1.5 system-ui, sans-serif; }
      header { padding: 24px 32px; border-bottom: 1px solid #2a1f1d; }
      h1 { margin: 0; font-weight: 600; letter-spacing: -0.01em; }
      main { padding: 32px; }
      .empty { color: #8d7d6a; }
    </style>
  </head>
  <body>
    <header>
      <h1>Vinaria 🍷</h1>
    </header>
    <main>
      <p class="empty">No bottles yet. Phase 5 will land the "Install Application" flow.</p>
    </main>
  </body>
</html>
