---
import Shell from "../layouts/Shell.astro";

// Phase-xp stub: the bottle list is empty until the Tauri IPC contract is
// wired up. Once src-tauri exposes list_bottles, this page will hydrate
// from the invoke handler.
const bottles: { id: string; name: string; recipe?: string; status: string }[] = [];
---

<Shell title="Vinaria — Bottles" active="bottles">
  <h1 class="page-title">Bottles</h1>
  <p class="page-subtitle">Windows applications running through your Wine install.</p>

  {bottles.length === 0 ? (
    <div class="empty-state">
      <h3>No bottles yet</h3>
      <p>A bottle is one Windows app set up to run on your Mac. Start with the recipe catalog or import an existing Wine prefix.</p>
      <button class="btn btn-primary">Install application</button>
    </div>
  ) : (
    <div class="card-grid">
      {bottles.map((b) => (
        <div class="card">
          <h3>{b.name}</h3>
          {b.recipe && <p style="color: var(--fg-muted); margin: 4px 0 12px;">recipe: {b.recipe}</p>}
          <span class={`badge badge-${b.status}`}>{b.status}</span>
        </div>
      ))}
    </div>
  )}
</Shell>
