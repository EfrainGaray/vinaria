{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vinaria",
  "version": "0.1.0",
  "identifier": "com.efraingaray.vinaria",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:4321",
    "beforeDevCommand": "pnpm --filter vinaria-ui dev",
    "beforeBuildCommand": "pnpm --filter vinaria-ui build"
  },
  "app": {
    "windows": [
      {
        "title": "Vinaria",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [],
    "category": "Utility",
    "shortDescription": "Run Windows apps on Intel Mac",
    "longDescription": "Vinaria is a free, open-source manager to run Windows applications on Intel Macs."
  }
}
